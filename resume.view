<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>View Resume | Harold A. Guzman</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css">
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,1,0" rel="stylesheet">
</head>
<body class="min-h-screen bg-base-200 font-sans text-base-content">
  <main class="flex min-h-screen flex-col">
    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 bg-base-100 px-4 py-3 sm:px-6">
      <a href="index.html" class="flex items-center gap-3 font-black tracking-tight"><span class="grid size-10 place-items-center rounded-xl bg-amber-400 text-xl text-slate-950">H</span><span>HAROLD<span class="text-amber-500">.</span></span></a>
      <div class="flex items-center gap-2">
        <a href="index.html" class="btn btn-ghost btn-sm rounded-xl"><span class="material-symbols-rounded">arrow_back</span>Back to portfolio</a>
        <a href="harold_guzman.pdf" target="_blank" rel="noopener" class="btn btn-warning btn-sm rounded-xl"><span class="material-symbols-rounded">download</span>Download PDF</a>
      </div>
    </header>
    <section class="flex-1 p-2 sm:p-4">
      <iframe src="harold_guzman.pdf" title="Harold A. Guzman Resume" class="h-[calc(100vh-5.5rem)] min-h-[500px] w-full rounded-xl border border-base-300 bg-base-100" loading="lazy"></iframe>
    </section>
  </main>
</body>
</html>